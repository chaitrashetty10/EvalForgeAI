# GEMINI_API_KEY: Required for live Google Gemini free-tier model & LLM-as-a-Judge calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional free-tier Groq API key (server-side only, disabled if unset)
GROQ_API_KEY=""

# Optional local Ollama endpoint for zero-cost local models (e.g., http://127.0.0.1:11434)
OLLAMA_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
